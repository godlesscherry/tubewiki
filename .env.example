# Forge works fully offline without any key (extractive documents).
# Add an OpenAI-compatible endpoint for LLM-written document sections + vision captions.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# FORGE_LLM_MODEL=llama3.1:8b          # e.g. local Ollama: base URL http://localhost:11434/v1
# FORGE_VISION_MODEL=gpt-4o-mini
# FORGE_DOC_MODE=auto                 # auto | extractive | llm
# FORGE_PORT=8787
# FORGE_WIKI=/absolute/path/to/forge-wiki
