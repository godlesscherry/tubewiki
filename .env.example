# TubeWiki works fully offline without any key (extractive documents).
# Add an OpenAI-compatible endpoint for LLM-written document sections + vision captions.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# TUBEWIKI_LLM_MODEL=llama3.1:8b          # e.g. local Ollama: base URL http://localhost:11434/v1
# TUBEWIKI_VISION_MODEL=gpt-4o-mini
# TUBEWIKI_DOC_MODE=auto                 # auto | extractive | llm
# TUBEWIKI_PORT=8787
# TUBEWIKI_WIKI=/absolute/path/to/vault
